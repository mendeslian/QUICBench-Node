# App
NODE_ENV=development
PORT=3000
TRUST_PROXY_HOPS=1
LOG_LEVEL=info

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Benchmark — defina true antes de npm run bench:run (desabilita rate limiter)
BENCHMARK_MODE=false
BENCH_MAX_BODY_BYTES=2097152
# METRICS_FILE=benchmarks/results/metrics.ndjson